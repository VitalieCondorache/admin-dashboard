# Admin Dashboard — environment variables.
# Copy to `.env` and fill in values. Do not commit `.env`.
#
# This project ships with a mock HTTP interceptor that fakes the `/api/*`
# endpoints, so it runs end-to-end without a real backend. If you point it
# at a live API later, override the base URL below at build time.
#
# Demo credentials (do NOT use in production):
#   email:    admin@demo.com
#   password: admin123

# Optional: override the API base URL consumed by `UsersApi` and friends.
# The default ('/api') is served by the in-app mock interceptor.
NG_APP_API_BASE_URL=/api
