{
  "name": "admin-dashboard",
  "version": "0.1.0",
  "description": "Angular 21 admin dashboard — signals, NgRx Signal Store, Tailwind + Material 3, Transloco i18n, and a built-in mock API so it runs with zero backend.",
  "author": "Vitalie Condorache <vitalie.condor@gmail.com> (https://github.com/VitalieCondorache)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VitalieCondorache/admin-dashboard.git"
  },
  "homepage": "https://github.com/VitalieCondorache/admin-dashboard#readme",
  "bugs": {
    "url": "https://github.com/VitalieCondorache/admin-dashboard/issues"
  },
  "keywords": [
    "angular",
    "angular-21",
    "signals",
    "ngrx-signals",
    "tailwindcss",
    "admin-dashboard",
    "portfolio"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:coverage": "ng test --coverage",
    "lint": "eslint \"src/**/*.{ts,html}\"",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\""
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@angular/animations": "^21.2.9",
    "@angular/cdk": "^21.2.7",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "^21.2.7",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@jsverse/transloco": "^8.3.0",
    "@ngrx/signals": "^21.1.0",
    "chart.js": "^4.5.1",
    "ng2-charts": "^10.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "verbose": "^0.2.3"
  },
  "devDependencies": {
    "@angular-eslint/schematics": "^21.3.1",
    "@angular/build": "^21.2.1",
    "@angular/cli": "^21.2.1",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "angular-eslint": "^21.3.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.2.1",
    "jsdom": "^28.0.0",
    "msw": "^2.13.4",
    "postcss": "^8.5.10",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.0.8"
  }
}
